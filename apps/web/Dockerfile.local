# Dockerfile.local - Packaging only (build happens locally)
# Build context must be the MONOREPO ROOT (not apps/web)
#
# Usage:
#   cd <monorepo-root>
#   pnpm --filter @pptnc/web build   # Build Next.js locally (has Firestore access)
#   docker build -f apps/web/Dockerfile.local -t pptnc:latest .
#
# This approach ensures SSG pages are generated with real Firestore data
# since the local environment has GCP credentials via gcloud ADC.

FROM node:22-alpine
WORKDIR /app

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy pre-built standalone output (monorepo-relative paths)
COPY --chown=nextjs:nodejs apps/web/public ./apps/web/public
COPY --chown=nextjs:nodejs apps/web/.next/standalone ./
COPY --chown=nextjs:nodejs apps/web/.next/static ./apps/web/.next/static

USER nextjs

EXPOSE 8080
ENV NODE_ENV=production

# HOSTNAME must be explicitly set to 0.0.0.0 because Cloud Run/K8s
# overrides the HOSTNAME env var with the pod instance name
CMD ["sh", "-c", "HOSTNAME=0.0.0.0 node apps/web/server.js"]
