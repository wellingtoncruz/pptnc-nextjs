# Client (NEXT_PUBLIC_*)
NEXT_PUBLIC_GA_MEASUREMENT_ID=  # Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)

# Server only
GOOGLE_PROJECT_ID=           # GCP Project (default pptnc-stage)
FIRESTORE_DATABASE_ID=       # Firestore named DB compartilhado com a IAra: pptnc-stage (dev, default) | pptnc-prod (produção, só no deploy). ⚠️ NUNCA use pptnc-prod localmente.
GOOGLE_APPLICATION_CREDENTIALS=  # Service account
UPSTASH_REDIS_REST_URL=      # Rate limiting
UPSTASH_REDIS_REST_TOKEN=    # Rate limiting
GEMINI_API_KEY=              # LLM (if not using ADC)
YOUTUBE_API_KEY=             # YouTube Data API v3 key (read-only) — used to reconcile episode visibility. Runtime-only: configurada como env var no serviço Cloud Run (NÃO via cloudbuild.yaml, que cuida apenas de envs de build/deploy). Sem ela o reconciliador esconde qualquer episódio cujo youtubePrivacyStatus no Firestore não seja já 'public'.
REVALIDATE_SECRET=           # Webhook invalidation
RESEND_API_KEY=              # Email service (resend.com)
