# Auth.js Configuration
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Trust host for development (required for localhost)
AUTH_TRUST_HOST=true

# Authorized redirect URIs in GCP Console:
# - Development: http://localhost:3000/api/auth/callback/google
# - Production: https://your-domain.com/api/auth/callback/google

# ============================================
# Firebase Configuration
# ============================================

# Firebase Admin SDK (server-side only)
# Auth uses Application Default Credentials (ADC) - NO key env vars needed!
# - Local: Run `gcloud auth application-default login`
# - Cloud Run: Automatically uses the service account assigned to the service
#
# Database selection (read by src/lib/firebase/config.ts; defaults are stage-safe):
#   GCP_PROJECT_ID        -> default 'pptnc-stage'
#   FIRESTORE_DATABASE_ID -> default 'pptnc-stage' (the dev/stage database)
#   PODCAST_ID            -> default 'pptnc'
# ⚠️ LOCAL DEV MUST stay on pptnc-stage. 'pptnc-prod' is the PRODUCTION database,
#    set ONLY by Cloud Build (prod deploy). NEVER put FIRESTORE_DATABASE_ID=pptnc-prod
#    in a local .env — you would read/write production data.
GCP_PROJECT_ID=pptnc-stage
FIRESTORE_DATABASE_ID=pptnc-stage
PODCAST_ID=pptnc

# Firebase Client SDK (public - exposed to browser)
# Get these from: https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
# Click "Add app" > Web app to get config values
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pptnc-stage.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pptnc-stage
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pptnc-stage.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:xxxxxxxxxxxxxxxx

# ============================================
# Application Version
# ============================================
# Displayed in the sidebar footer
NEXT_PUBLIC_APP_VERSION=v2.1.0-beta-iara

# ============================================
# Vertex AI (Gemini) Configuration
# ============================================

# Uses Application Default Credentials (ADC) - NO env vars needed!
# - Local: Run `gcloud auth application-default login`
# - Cloud Run: Automatically uses the service account assigned to the service
# Project ID and Location are hardcoded in src/lib/llm/client.ts

# ============================================
# Cloud Storage (Newsletter Images)
# ============================================
# Bucket name for newsletter images (defaults to project default bucket if empty)
NEWSLETTER_IMAGES_BUCKET=

# ============================================
# BrightData API (LinkedIn Scraping)
# ============================================
# API key for BrightData Web Scraper API (LinkedIn profile enrichment)
# Get from: https://brightdata.com/cp/api_tokens
# If not set, guest scraping is silently skipped (no crash)
BRIGHTDATA_API_KEY=your-brightdata-api-key-here

# ============================================
# LinkedIn OAuth (Social Publishing)
# ============================================
# Create app at: https://www.linkedin.com/developers/apps
# Required scopes: w_organization_social, r_organization_social, rw_organization_admin
# Redirect URI must match LINKEDIN_REDIRECT_URI below
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# ============================================
# Cloud Tasks (Scheduled Publishing)
# ============================================
# Set to 'false' for local dev (executes inline without Cloud Tasks)
CLOUD_TASKS_ENABLED=true
