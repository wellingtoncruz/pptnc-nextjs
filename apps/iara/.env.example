# Auth.js Configuration
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Trust host for development (required for localhost)
AUTH_TRUST_HOST=true

# Authorized redirect URIs in GCP Console:
# - Development: http://localhost:3000/api/auth/callback/google
# - Production: https://your-domain.com/api/auth/callback/google

# ============================================
# Firebase Configuration
# ============================================

# Firebase Admin SDK (server-side only)
# Uses Application Default Credentials (ADC) - NO env vars needed!
# - Local: Run `gcloud auth application-default login`
# - Cloud Run: Automatically uses the service account assigned to the service
# Project ID and Database ID are hardcoded in src/lib/firebase/admin.ts

# Firebase Client SDK (public - exposed to browser)
# Get these from: https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
# Click "Add app" > Web app to get config values
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pptnc-stage.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pptnc-stage
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pptnc-stage.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:xxxxxxxxxxxxxxxx
