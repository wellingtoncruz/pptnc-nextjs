# Dockerfile.local - Packaging only (build happens locally)
#
# Usage:
#   npm run build                              # Build Next.js locally (has Firestore access)
#   docker build -f Dockerfile.local -t pptnc:latest .
#
# This approach ensures SSG pages are generated with real Firestore data
# since the local environment has GCP credentials via gcloud ADC.

FROM node:22-alpine
WORKDIR /app

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy pre-built standalone output
COPY --chown=nextjs:nodejs public ./public
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NODE_ENV=production

CMD ["node", "server.js"]
