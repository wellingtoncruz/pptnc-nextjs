# Dependencies (installed during Docker build)
**/node_modules
npm-debug.log*

# Re-include node_modules inside standalone output (required for runtime)
!apps/web/.next/standalone/**/node_modules

# Next.js build cache (keep standalone output for stage/local builds)
apps/web/.next/cache
apps/web/out

# Testing
**/*.test.ts
**/*.test.tsx
**/__tests__
**/coverage

# IDE
.vscode
.idea
**/*.swp
**/*.swo

# Git
.git
.gitignore

# Environment (secrets injected at runtime)
.env
.env.*
!.env.example

# Documentation
*.md
LICENSE
docs/

# Build/CI artifacts
**/Dockerfile
**/Dockerfile.*
.dockerignore
cloudbuild.yaml

# OS files
.DS_Store
Thumbs.db

# Scripts (not needed in container)
scripts/

# Turbo cache
.turbo
